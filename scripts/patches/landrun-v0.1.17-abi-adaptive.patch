+//
+// The sandbox targets exactly this version instead of the build-time version:
+// go-landlock v0.9 (and therefore upstream landrun >= v0.1.17) hard-codes
+// Landlock ABI v9, i.e. Linux >= 7.1, and refuses to start on older kernels
+// that still provide a perfectly usable ABI v7 (Linux 6.15 - 6.17).
+//
+// Patch: landrun-v0.1.17-abi-adaptive.patch (local build, 2026-10-27).
+var kernelLandlockABI = detectLandlockABI()
+
+func detectLandlockABI() int {
+	v, err := syscall.LandlockGetABIVersion()
+	if err != nil {
+		return 0
+	}
+	return v
+}
+
+// fsRightsFor returns the union of every filesystem access right supported
+// by the given Landlock ABI version.
+func fsRightsFor(abi int) landlock.AccessFSSet {
+	s := landlock.AccessFSSet(
+		syscall.AccessFSExecute |
+			syscall.AccessFSWriteFile |
+			syscall.AccessFSReadFile |
+			syscall.AccessFSReadDir |
+			syscall.AccessFSRemoveDir |
+			syscall.AccessFSRemoveFile |
+			syscall.AccessFSMakeChar |
+			syscall.AccessFSMakeDir |
+			syscall.AccessFSMakeReg |
+			syscall.AccessFSMakeSock |
+			syscall.AccessFSMakeFifo |
+			syscall.AccessFSMakeBlock |
+			syscall.AccessFSMakeSym |
+			syscall.AccessFSRefer,
+	)
+	if abi >= 2 {
+		s |= landlock.AccessFSSet(syscall.AccessFSTruncate)
+	}
+	if abi >= 5 {
+		s |= landlock.AccessFSSet(syscall.AccessFSIoctlDev)
+	}
+	if abi >= 9 {
+		s |= landlock.AccessFSSet(syscall.AccessFSResolveUnix)
+	}
+	return s
+}
+
+// netRightsFor returns the network access rights supported by abi (V4+).
+func netRightsFor(abi int) landlock.AccessNetSet {
+	if abi < 4 {
+		return 0
+	}
+	return landlock.AccessNetSet(syscall.AccessNetBindTCP | syscall.AccessNetConnectTCP)
+}
+
+// scopedRightsFor returns the IPC scopes supported by abi (V6+).
+func scopedRightsFor(abi int) landlock.ScopedSet {
+	if abi < 6 {
+		return 0
+	}
+	return landlock.ScopedSet(syscall.ScopeAbstractUnixSocket | syscall.ScopeSignal)
+}
