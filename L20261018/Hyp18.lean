import TauCeti.FieldTheory.Kummer.IntermediateField
import TauCeti.FieldTheory.GaloisCohomology.Kummer
import L20261018.Hyp17
/-!
# `prop:bi-kummer-kernel`: `Eˣ ∩ Fˣ = F^{×p}⟨a₁,a₂⟩`

This file assembles the two halves of campaign item (e).

* `Hyp16.lean`: `kummerRes (kummerMap a) = 1 ↔ a` becomes an `n`-th power in the extension, so the
  kernel of restriction consists exactly of the units that become `n`-th powers upstairs.
* `Hyp17.lean` (`BKummer.le_mul_pow_of_kummerField_eq`): equal Kummer fields force containment of
  power classes.

Here we put them together for the bi-Kummer field `E = F(Δ^{1/p})`: if `α^p = a` and `α ∈ E`, then
`a ∈ (Fˣ)^p ⊔ Δ`, i.e. the class of `a` in `Fˣ⧸(Fˣ)^p` already lies in the span of `Δ`. For
`Δ = ⟨a₁, a₂⟩` this is `Eˣ ∩ Fˣ ⊆ F^{×p}⟨a₁,a₂⟩`.

The three ingredients of the assembly:

1. **roots (closure under `a^k`)**: a `p`-th root of `δ·a^k` is `x_δ·α^k`, which needs `zpow` on the
   separable closure and `α ≠ 0`;
2. **field equality** `F(Δ'^{1/p}) = F(Δ^{1/p})` for `Δ' = Δ ⊔ ⟨a⟩`: the missing inclusion uses
   `TauCeti.exists_eq_algebraMap_mul_of_pow_eq` (two `p`-th roots of the same element differ by a
   constant, which needs `μ_p ⊂ F`);
3. **finite relative index of `Δ'`**: `Δ'/Δ` is generated by `a`, whose `p`-th power lies in
   `(Fˣ)^p`, so modulo `(Fˣ)^p` that generator has order dividing `p`.
-/

open TauCeti

set_option maxHeartbeats 1000000

namespace BKummer

variable {F : Type*} [Field F] {p : ℕ} [Fact p.Prime] [HasEnoughRootsOfUnity F p]

/-- **The bi-Kummer kernel, field-theory form.** If `a : Fˣ` becomes a `p`-th power in the Kummer
field `F(Δ^{1/p})`, then its class lies in the span of `Δ` modulo `p`-th powers:
`a ∈ (Fˣ)^p ⊔ Δ`. -/
theorem mem_sup_of_isPow_in_kummerField (Δ : Subgroup Fˣ) (a : Fˣ)
    (hroots : ∀ b ∈ Δ, ∃ x : SeparableClosure F, x ^ p = algebraMap F (SeparableClosure F) ↑b)
    [(powMonoidHom p : Fˣ →* Fˣ).range.IsFiniteRelIndex Δ]
    (α : SeparableClosure F) (hα : α ^ p = algebraMap F (SeparableClosure F) ↑a)
    (hαE : α ∈ kummerField (SeparableClosure F) p Δ) :
    a ∈ (powMonoidHom p : Fˣ →* Fˣ).range ⊔ Δ := by
  classical
  set P : Subgroup Fˣ := (powMonoidHom p : Fˣ →* Fˣ).range with hP
  have hα0 : α ≠ 0 := by
    intro h
    rw [h, zero_pow (NeZero.ne p)] at hα
    have hne : (algebraMap F (SeparableClosure F) (↑a : F)) ≠ 0 := by simpa using a.ne_zero
    exact hne hα.symm
  set Δ' : Subgroup Fˣ := Δ ⊔ Subgroup.zpowers a with hΔ'
  -- A `p`-th root of `a ^ k`, for every integer `k`.
  have hαpow : ∀ k : ℤ, (α ^ k) ^ p = algebraMap F (SeparableClosure F) (↑(a ^ k) : F) := by
    intro k
    rw [← zpow_natCast (α ^ k) p, ← zpow_mul, mul_comm (k : ℤ) (p : ℤ), zpow_mul,
      zpow_natCast α p, hα, Units.val_zpow_eq_zpow_val]
    exact (map_zpow₀ (algebraMap F (SeparableClosure F)) (↑a) k).symm
  -- (1) every element of `Δ'` has a `p`-th root in the separable closure
  have hroot : ∀ b ∈ Δ', ∃ x : SeparableClosure F, x ^ p = algebraMap F (SeparableClosure F) ↑b := by
    intro b hb
    obtain ⟨δ, hδ, y, hy, rfl⟩ := Subgroup.mem_sup.1 hb
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hy
    obtain ⟨x, hx⟩ := hroots δ hδ
    refine ⟨x * α ^ k, ?_⟩
    rw [mul_pow, hx, hαpow k, Units.val_mul, map_mul]
  -- (2) the Kummer fields of `Δ` and of `Δ'` agree
  have hfield : kummerField (SeparableClosure F) p Δ = kummerField (SeparableClosure F) p Δ' := by
    refine le_antisymm (kummerField_mono le_sup_left) ?_
    refine kummerField_le_iff.2 fun b hb x hx => ?_
    -- a root of `b` already lies in `F(Δ^{1/p})`
    obtain ⟨x₀, hx₀⟩ := hroot b hb
    have hx₀E : x₀ ∈ kummerField (SeparableClosure F) p Δ := by
      obtain ⟨δ, hδ, y, hy, rfl⟩ := Subgroup.mem_sup.1 hb
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hy
      obtain ⟨xd, hxd⟩ := hroots δ hδ
      have hpow : (xd * α ^ k) ^ p = x₀ ^ p := by
        rw [mul_pow, hxd, hαpow k, hx₀, Units.val_mul, map_mul]
      obtain ⟨c, hc⟩ := exists_eq_algebraMap_mul_of_pow_eq (K := F) hpow.symm
      rw [hc]
      exact (kummerField (SeparableClosure F) p Δ).mul_mem
        ((kummerField (SeparableClosure F) p Δ).algebraMap_mem c)
        ((kummerField (SeparableClosure F) p Δ).mul_mem
          (mem_kummerField_of_pow_eq hδ hxd) ((kummerField (SeparableClosure F) p Δ).pow_mem hαE k))
    -- two `p`-th roots of the same element differ by a constant
    obtain ⟨c, hc⟩ := exists_eq_algebraMap_mul_of_pow_eq (K := F) (hx.trans hx₀.symm)
    rw [hc]
    exact (kummerField (SeparableClosure F) p Δ).mul_mem
      ((kummerField (SeparableClosure F) p Δ).algebraMap_mem c) hx₀E
  -- (3) `Δ'` has finite index modulo `p`-th powers
  have hfin' : P.IsFiniteRelIndex Δ' := by
    have hker : (QuotientGroup.mk' P).ker = P := QuotientGroup.ker_mk' P
    have hcard : ∀ K : Subgroup Fˣ,
        Nat.card ↥(Subgroup.map (QuotientGroup.mk' P) K) = P.relIndex K := by
      intro K
      rw [← Subgroup.relIndex_ker K (QuotientGroup.mk' P), hker]
    have hmap : Subgroup.map (QuotientGroup.mk' P) Δ'
        = Subgroup.map (QuotientGroup.mk' P) Δ
          ⊔ Subgroup.map (QuotientGroup.mk' P) (Subgroup.zpowers a) := by
      rw [hΔ', Subgroup.map_sup]
    have hA : Nat.card ↥(Subgroup.map (QuotientGroup.mk' P) Δ) ≠ 0 := by
      rw [hcard Δ]
      exact Subgroup.IsFiniteRelIndex.relIndex_ne_zero
    have hzp : Subgroup.map (QuotientGroup.mk' P) (Subgroup.zpowers a)
        = Subgroup.zpowers (QuotientGroup.mk' P a) := by
      ext y
      constructor
      · rintro ⟨z, hz, rfl⟩
        obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 hz
        exact Subgroup.mem_zpowers_iff.2 ⟨n, by rw [map_zpow]⟩
      · intro hy
        obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 hy
        exact ⟨a ^ n, Subgroup.mem_zpowers_iff.2 ⟨n, rfl⟩, by rw [map_zpow]⟩
    have hB : Nat.card ↥(Subgroup.zpowers (QuotientGroup.mk' P a)) ≠ 0 := by
      rw [Nat.card_zpowers]
      have hdvd : orderOf (QuotientGroup.mk' P a) ∣ p := by
        rw [orderOf_dvd_iff_pow_eq_one]
        have h1 : (QuotientGroup.mk' P a) ^ p = (QuotientGroup.mk' P) (a ^ p) :=
          (map_pow (QuotientGroup.mk' P) a p).symm
        rw [h1, ← MonoidHom.mem_ker, hker]
        exact ⟨a, powMonoidHom_apply p a⟩
      exact Nat.pos_iff_ne_zero.1 (Nat.pos_of_dvd_of_pos hdvd (Fact.out : p.Prime).pos)
    have hsup : Finite ↥(Subgroup.map (QuotientGroup.mk' P) Δ
        ⊔ Subgroup.map (QuotientGroup.mk' P) (Subgroup.zpowers a)) := by
      rw [hzp]
      haveI hAf : Finite ↥(Subgroup.map (QuotientGroup.mk' P) Δ) := (Nat.card_ne_zero.1 hA).2
      haveI hBf : Finite ↥(Subgroup.zpowers (QuotientGroup.mk' P a)) :=
        (Nat.card_ne_zero.1 hB).2
      refine Finite.of_surjective
        (fun pr : ↥(Subgroup.map (QuotientGroup.mk' P) Δ)
            × ↥(Subgroup.zpowers (QuotientGroup.mk' P a)) =>
          (⟨pr.1.1 * pr.2.1, Subgroup.mul_mem_sup pr.1.2 pr.2.2⟩ :
            ↥(Subgroup.map (QuotientGroup.mk' P) Δ
              ⊔ Subgroup.zpowers (QuotientGroup.mk' P a)))) ?_
      rintro ⟨y, hy⟩
      have hy' : y ∈ Subgroup.map (QuotientGroup.mk' P) Δ' := by
        rw [hmap, hzp]
        exact hy
      obtain ⟨b, hb, hbq⟩ := Subgroup.mem_map.1 hy'
      obtain ⟨δ, hδ, v, hv, hbv⟩ := Subgroup.mem_sup.1 hb
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 hv
      refine ⟨(⟨QuotientGroup.mk' P δ, Subgroup.mem_map_of_mem _ hδ⟩,
        ⟨(QuotientGroup.mk' P a) ^ k, Subgroup.mem_zpowers_iff.2 ⟨k, rfl⟩⟩), ?_⟩
      refine Subtype.ext ?_
      show (QuotientGroup.mk' P) δ * (QuotientGroup.mk' P a) ^ k = y
      have hb' : b = δ * a ^ k := by rw [← hbv, hk]
      rw [← hbq, hb', map_mul, map_zpow]
    rw [Subgroup.isFiniteRelIndex_iff_relIndex_ne_zero, ← hcard Δ', hmap]
    exact Nat.card_ne_zero.2 ⟨⟨1, Subgroup.one_mem _⟩, hsup⟩
  -- (4) apply the general lemma
  haveI := hfin'
  have hle := le_mul_pow_of_kummerField_eq (p := p) (Δ := Δ) (Δ' := Δ')
    le_sup_left hroots hroot hfield
  refine hle (Subgroup.mem_sup.2 ⟨1, Δ.one_mem, a, ?_, one_mul a⟩)
  exact Subgroup.mem_zpowers_iff.2 ⟨1, by simp⟩

end BKummer
